{# One checkpoint's section - 3.2.

   Eight parts, in the order 3.2 lists them: heading, the two status badges, a
   detail table, the evidence grid, the sensor table, the sensor's own
   warnings, the findings that name this checkpoint, and the operator notes.

   Nothing here decides anything. Which cell shows a picture and which shows
   words, whether a sensor block carries values, and why a value is not there,
   were all settled by detect_gaps and assembled by checkpoint_views (5.4).

   Every free-text field on the page - notes, observed, expected_text,
   missed_reason, a finding's description - is rendered through autoescaping,
   so a field holding <script> or {{ '{{ config }}' }} prints as written (5.5). #}

{# A field the loader refused prints the gap type where its value would have
   been. "Not recorded" and "Not scored" are what an absent field reads as, and
   a refused one is a different fact: the record carried something and it could
   not be used, so the cell says which (decision 168). #}
{% macro cell(refused, field, value) -%}
  {%- if field in refused -%}
    <span class="gap-tag">{{ refused[field].gap_type }}</span>
  {%- else -%}
    {{ value }}
  {%- endif -%}
{%- endmacro %}

<section class="section checkpoints" id="checkpoints">

  <h2>Checkpoints</h2>

{% for group in checkpoint_zones %}

  {# 3.1 groups the checkpoint sections by zone, with a header per group. 2.2
     calls zone the grouping key; a run can put several checkpoints in one zone
     or one in each. styles.css keeps a zone header with the group it heads. #}
  <h3 class="zone-head">{{ group.zone }}</h3>

  {% for view in group.checkpoints %}
  {% set point = view.checkpoint %}
  <div class="checkpoint-block">

    {# --- heading and the two badges (3.2) --- #}
    <h4 class="checkpoint-head">
      {{ point.checkpoint_name }}
      <span class="checkpoint-id">{{ point.checkpoint_id }}</span>
      {% if point.sequence_number is not none %}
        <span class="checkpoint-seq">Sequence {{ point.sequence_number }}</span>
      {% endif %}
    </h4>

    {# 3.2: two badges, side by side, never collapsed into one. status says
       whether the robot arrived; result_status is the verdict it recorded.
       A checkpoint can be COMPLETED and FAIL, which is why both are here. #}
    <p class="badge-pair">
      <span class="badge badge-small badge-{{ point.status | status_style }}">{{ point.status }}</span>
      <span class="badge badge-small badge-{{ point.result_status | verdict_style }}">{{ point.result_status }}</span>
    </p>

    {# Every absence stated because detect_gaps raised a gap names that gap, so
       a reader can match the sentence to the manifest entry behind it (4.4). #}
    {% if view.missed %}
      <p class="absent-strong">
        <span class="gap-tag">{{ view.missed.gap_type }}</span>
        Not reached. {{ view.missed.detail }}
      </p>
    {% endif %}

    {# Fields this checkpoint recorded as the wrong type. The loader refused
       each one rather than converting it, so the table below prints the field
       as not recorded and this says why - a confidence written as "0.94" is a
       string, and never becomes a measurement on the way to the page (TA-27). #}
    {% for note in view.datatypes %}
      <p class="absent-strong">
        <span class="gap-tag">{{ note.gap_type }}</span>
        Refused as recorded, and left unset. {{ note.detail }}
      </p>
    {% endfor %}

    {# --- detail table (3.2) --- #}
    {# Two label/value pairs to a row. The same seven fields 3.2 lists, in the
       same order, read down the left column then down the right; the expected
       condition takes the full width because it is a sentence, not a value. #}
    <table class="detail-table detail-pairs">
      <tbody>
        <tr>
          <th>Recorded</th><td>{{ cell(view.refused, "timestamp", point.timestamp | moment) }}</td>
          <th>Rule type</th><td>{{ cell(view.refused, "rule_type", point.rule_type | show) }}</td>
        </tr>
        <tr>
          <th>Zone</th><td>{{ cell(view.refused, "zone", point.zone) }}</td>
          <th>Confidence</th><td>{{ cell(view.refused, "confidence", point.confidence | measure | show("Not scored")) }}</td>
        </tr>
        <tr>
          <th>Position</th><td>{{ cell(view.refused, "coordinates", point.coordinates | place | show) }}</td>
          <th>Observed</th><td>{{ cell(view.refused, "observed", point.observed | show) }}</td>
        </tr>
        <tr>
          <th>Expected</th><td colspan="3">{{ cell(view.refused, "expected_text", point.expected_text | show) }}</td>
        </tr>
      </tbody>
    </table>

    {# --- evidence grid (3.2) ---

       A table rather than a grid of boxes, because a table head repeats itself
       when the rows run past a page end. That is what carries 5.5's repeated
       heading onto the continuation, and it breaks between rows of cells and
       never inside one. #}
    {% if view.no_evidence %}
      <p class="absent-strong">
        <span class="gap-tag">{{ view.no_evidence.gap_type }}</span>
        No evidence captured. {{ view.no_evidence.detail }}
      </p>
    {% endif %}

    {# A grid whose every cell says the same thing is one fact printed once per
       cell. Where the checkpoint recorded no evidence path at all the grid
       collapses to the line below; where every view carried an RGB and none
       carried a thermal, the cells keep their RGB and the missing thermal is
       stated once under the grid. A partial grid is never collapsed - that is
       the case the grid exists for. #}
    {% if view.evidence.empty %}
      <p class="evidence-collapsed">
        No evidence captured - {{ view.evidence.rgb }} views carried an
        image, and none carried a thermal.
      </p>
    {% else %}
      <table class="evidence-grid">
        <thead>
          <tr>
            <th colspan="{{ view.evidence.columns }}">
              Evidence - {{ point.checkpoint_name }}
            </th>
          </tr>
        </thead>
        <tbody>
          {# Rows of view.evidence.columns, which is the configured grid_columns
             or fewer where the checkpoint recorded fewer views. One view fills
             the row, two sit side by side, and seven draw four and then three.
             The cells of one checkpoint are all the same width; only how many
             there are changes (decision 174). #}
          {% for row in view.evidence.cells | batch(view.evidence.columns) %}
            <tr>
              {% for cell in row %}
                <td class="evidence-cell">
                  {# Only where the filenames named the view. A route that
                     photographs each checkpoint once labels nothing, and an
                     empty caption band above every picture says nothing. #}
                  {% if cell.view %}
                    <span class="view-label">{{ cell.view }}</span>
                  {% endif %}

                  {% if cell.rgb_src %}
                    <img class="evidence-rgb" src="{{ cell.rgb_src }}" alt="{{ cell.view or point.checkpoint_name }}">
                  {% else %}
                    <span class="image-absent">
                      {% if cell.rgb_gap %}
                        <span class="gap-tag">{{ cell.rgb_gap }}</span>
                      {% endif %}
                      {{ cell.rgb_absent }}
                    </span>
                  {% endif %}

                  {# The label sits outside the branch. Inside it, a cell with no
                     thermal loses the label's height and its placeholder rides
                     about 4mm above the thermal images either side of it, so a
                     row of mixed cells does not line up. #}
                  {% if not view.evidence.thermal_absent %}
                    <span class="modality">Thermal</span>
                    {% if cell.thermal_src %}
                      <img class="evidence-thermal" src="{{ cell.thermal_src }}" alt="{{ cell.view or point.checkpoint_name }} thermal">
                    {% else %}
                      <span class="thermal-absent">
                        {% if cell.thermal_gap %}
                          <span class="gap-tag">{{ cell.thermal_gap }}</span>
                        {% endif %}
                        {{ cell.thermal_absent }}
                      </span>
                    {% endif %}
                  {% endif %}
                </td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>

      {% if view.evidence.thermal_absent %}
        <p class="table-note">
          {% if view.evidence.thermal_note %}
            <span class="gap-tag">{{ view.evidence.thermal_note.gap_type }}</span>
          {% endif %}
          No thermal image was captured for any view - {{ view.evidence.thermal }}.
          The RGB images above are the whole of this checkpoint's evidence.
        </p>
      {% endif %}
    {% endif %}

    {# --- sensor table (3.2, and the rule in 2.8) ---

       A block with no rows has no numbers to print, because none were read.
       The words name the device that said so. #}
    <h5>Sensor</h5>

    {% if view.sensor.unavailable %}
      <p class="absent-strong">
        <span class="gap-tag">{{ view.sensor.unavailable.gap_type }}</span>
        Sensor unavailable - {{ view.sensor.unavailable.detail }}
      </p>
    {% else %}
      {% if view.sensor.stale %}
        <p class="absent-strong">
          <span class="gap-tag">{{ view.sensor.stale.gap_type }}</span>
          Reading stale - {{ view.sensor.stale.detail }}
        </p>
      {% endif %}

      <table class="detail-table sensor-table">
        <tbody>
          {% for block in view.sensor.blocks %}
            <tr class="sensor-block-head">
              <th colspan="2">{{ block.name }}</th>
            </tr>
            {% if block.absent %}
              <tr>
                <td colspan="2">
                  {% if block.absent_gap %}
                    <span class="gap-tag">{{ block.absent_gap }}</span>
                  {% endif %}
                  <span class="absent">{{ block.absent }}</span>
                </td>
              </tr>
            {% else %}
              {% for label, value, refused in block.rows %}
                <tr>
                  <th>{{ label }}</th>
                  <td>
                    {% if refused %}
                      <span class="gap-tag">{{ refused }}</span>
                    {% else %}
                      {{ value }}
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    {% endif %}

    {# --- the sensor's own warnings (3.2) ---

       The heading prints whether or not there are warnings. A section that
       disappears when it holds nothing leaves a reader unable to tell a
       checkpoint that raised no warning from one where the section failed to
       render, and 0 asks for an absence to be stated where the missing thing
       would have been.

       An unavailable reading gets different words: nothing was read, so "no
       warnings" would be read as good news about a device that said nothing at
       all (decision 19). #}
    <h5>Sensor warnings</h5>

    {% if view.sensor.warnings %}
      <ul class="warning-list">
        {% for warning in view.sensor.warnings %}
          <li>
            <span class="badge badge-small badge-{{ warning.severity | severity_style }}">
              {{- warning.severity | show("unrated") -}}
            </span>
            {{ warning.label | show }} - {{ warning.description | show }}
          </li>
        {% endfor %}
      </ul>
    {% elif view.sensor.unavailable %}
      <p class="absent-note">
        No sensor warnings recorded. The reading itself was unavailable, so this
        is not a statement that the sensors were healthy.
      </p>
    {% else %}
      <p class="absent-note">No sensor warnings recorded for this checkpoint.</p>
    {% endif %}

    {# --- findings naming this checkpoint (3.2) ---

       The same entries the findings summary lists. 3.2 asks for them here as
       well, so a reader working through one checkpoint does not have to hold
       the summary in their head. #}
    <h5>Findings</h5>

    {% if view.findings %}
      <table class="data-table">
        <thead>
          <tr>
            <th>Severity</th>
            <th>Feature</th>
            <th>What was found</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {% for finding in view.findings %}
            <tr>
              <td>
                <span class="badge badge-small badge-{{ finding.severity | severity_style }}">
                  {{- finding.severity -}}
                </span>
              </td>
              <td>{{ finding.feature | show }}</td>
              <td>{{ finding.description | show }}</td>
              <td>{{ finding.status }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="absent-note">
        {% if view.no_findings %}
          <span class="gap-tag">{{ view.no_findings.gap_type }}</span>
        {% endif %}
        No findings recorded for this checkpoint.
      </p>
    {% endif %}

    {# --- operator notes (3.2, 2.9) ---

       Verbatim, under that label. 2.9 is explicit: this field can hold
       developer text, and it is neither the engine's job to filter it nor to
       dress it up as an inspection conclusion. #}
    <h5>Operator notes</h5>
    <p class="operator-notes">{{ point.notes | show("No operator notes recorded.") }}</p>

  </div>
  {% endfor %}

{% else %}

  {# A run with no checkpoints reached this section too, and a heading with
     nothing under it reads as a section that failed to render rather than as a
     run that had nothing to put in one. The cover and the coverage page say the
     same thing in the same words, from the same gap (decision 177). #}
  <p class="absent-strong">
    {% if empty_record %}
      <span class="gap-tag">{{ empty_record.gap_type }}</span>
    {% endif %}
    No checkpoints were recorded for this run, so there are no checkpoint
    sections to show.
  </p>

{% endfor %}

</section>
