<section class="section findings" id="findings">

  <h2>Findings</h2>

  <p class="findings-count">
    {% if findings_row.computed %}
      {{ findings_row.computed }} finding{{ "" if findings_row.computed == 1 else "s" }} recorded for this run.
    {% else %}
      No findings were recorded for this run.
    {% endif %}
    {% if findings_row.disagrees %}
      <span class="absent-strong">The record declares {{ findings_row.declared | show("none") }}. Both figures are printed; neither is corrected. The conflict is set out on the coverage page.</span>
    {% endif %}
  </p>

  {% for group in finding_groups %}
    {% if group.findings or group.absent %}

      <h3>{{ group.heading }}{% if group.findings %} ({{ group.findings | length }}){% endif %}</h3>

      {% if group.findings %}
        <p class="lede">{{ group.lede }}</p>
        <table class="data-table findings-table">
          {# Five equal columns leave Checkpoint about 33mm of text, and
             `home_docking_station` is wider than that, so the shared
             overflow-wrap broke it mid-word - "home_docking_statio" above an
             orphaned "n". The widths are declared here instead: Severity and
             Status hold short words, so the space they were given goes to the
             two columns that carry identifiers. #}
          <colgroup>
            <col class="col-severity">
            <col class="col-checkpoint">
            <col class="col-feature">
            <col class="col-status">
            <col class="col-recorded">
          </colgroup>
          <thead>
            <tr>
              <th>Severity</th>
              <th>Checkpoint</th>
              <th>Feature</th>
              <th>Status</th>
              <th>Recorded</th>
            </tr>
          </thead>
          {% for finding in group.findings %}
            <tbody class="finding">
              <tr>
                <td>
                  <span class="badge badge-small badge-{{ finding.severity | severity_style }}">
                    {{- finding.severity -}}
                  </span>
                </td>
                <td>
                  {# nowrap on the id alone: the zone beneath it is prose and
                     may wrap, but an id split across two lines reads as two
                     different ids. #}
                  <span class="finding-checkpoint">{{ finding.checkpoint_id | show }}</span>
                  {% if finding.zone and finding.zone != finding.checkpoint_id %}
                    <span class="finding-zone">{{ finding.zone }}</span>
                  {% endif %}
                </td>
                <td>{{ finding.feature | show }}</td>
                <td>{{ finding.status }}</td>
                <td>{{ finding.timestamp | moment }}</td>
              </tr>
              {# 2.4 warns that finding_id is long and must not overflow its
                 cell, so the detail spans the row rather than sitting in a
                 column that cannot hold it. The severity column is left clear,
                 which indents the block under the finding it belongs to. #}
              <tr class="finding-detail">
                <td></td>
                <td colspan="4">
                  <span class="finding-line">
                    <span class="finding-label">What was found</span>
                    {{ finding.description | show }}
                  </span>
                  {# Every line prints, whether or not the field carries
                     anything. A line that vanishes when the field is null tells
                     a reader nothing about whether the finding had no
                     recommendation or the report dropped it (0, 3.6). #}
                  <span class="finding-line">
                    <span class="finding-label">Recommended</span>
                    {{ finding.recommended_action | show("No recommended action recorded") }}
                  </span>
                  <span class="finding-line">
                    <span class="finding-label">Position</span>
                    {{ finding.coordinates | place | show("No position recorded") }}
                  </span>
                  <span class="finding-line">
                    <span class="finding-label">Evidence</span>
                    {{ finding.evidence_image | show("No evidence image linked") }}
                  </span>
                  <span class="finding-line">
                    <span class="finding-label">Reference</span>
                    <span class="finding-id">{{ finding.finding_id }}</span>
                  </span>
                </td>
              </tr>
            </tbody>
          {% endfor %}
        </table>
      {% else %}
        <p class="absent-note">{{ group.absent }}</p>
      {% endif %}

    {% endif %}
  {% endfor %}

</section>
