{# The report shell.

   3.1 fixes the order of the sections: cover, coverage, findings, alerts,
   checkpoint sections, summary table, provenance footer. Each is included only
   when config turns it on (5.7), and the manifest omits the entry for any
   section that was left out (4.4).

   Sections are added here as they are built. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Inspection report {{ record.run_id }}</title>
</head>
<body>

{% if sections.cover %}
  {% include "_cover.html.j2" %}
{% endif %}

{# B-2's summary, straight after the cover. Not one of 5.7's seven sections:
   its switch is on only when config asks for it and B-2 gave text. #}
{% if sections.executive_summary %}
  {% include "_executive_summary.html.j2" %}
{% endif %}

{# B-3's action plan, straight after the summary page. Not one of 5.7's seven
   sections: its switch is on only when config asks for it and B-3 gave a plan. #}
{% if sections.action_plan %}
  {% include "_action_plan.html.j2" %}
{% endif %}

{# Front matter, not one of 5.7's seven sections: it says where they are, so
   it renders whenever anything else does. #}
{% include "_contents.html.j2" %}

{% if sections.coverage %}
  {% include "_coverage.html.j2" %}
{% endif %}

{% if sections.findings %}
  {% include "_findings.html.j2" %}
{% endif %}

{% if sections.alerts %}
  {% include "_alerts.html.j2" %}
{% endif %}

{% if sections.zone_telemetry %}
  {% include "_zone.html.j2" %}
{% endif %}

{% if sections.checkpoints %}
  {% include "_checkpoint.html.j2" %}
{% endif %}

{% if sections.summary %}
  {% include "_summary.html.j2" %}
{% endif %}

</body>
</html>
